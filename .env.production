POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=appdb
POSTGRES_PORT=5432

DATABASE_URL=postgresql://appuser:changeme@db:5432/appdb?schema=public
BACKEND_PORT=8080
FRONTEND_PORT=3000
RUST_LOG=info

# Required application secrets: replace with long random values
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_TTL_SECONDS=14400
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-refresh-secret
REFRESH_TOKEN_TTL_SECONDS=604800

# Login protection
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_LOCK_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Optional values used by docker-compose.prod.yml for GHCR images
GITHUB_REPOSITORY_OWNER=your-org
GITHUB_REPOSITORY_NAME=bowpos
